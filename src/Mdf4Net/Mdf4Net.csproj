<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Mdf4Net</RootNamespace>
    <Description>Read and write ASAM MDF 4.x (MF4) measurement data files in pure .NET: sorted and unsorted data groups, DT/DL/DZ/HL data blocks with deflate and transposition, variable-length signal data, channel conversions, and ASAM bus logging for CAN and CAN FD. No native dependencies.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" />
  </ItemGroup>

  <PropertyGroup Label="Strong name">
    <!--
      Strong-named from the first release on, so that strong-named .NET Framework applications can
      reference the package; adding it later would change the assembly identity. The key is
      committed and public: it provides identity only, not authenticity (that is what the signed
      provenance attestation of each release is for). The SNK holds the private key, so assemblies
      are fully signed on every platform; public signing would fail strong-name verification on
      .NET Framework.
    -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mdf4Net.snk</AssemblyOriginatorKeyFile>
    <!-- Public key of Mdf4Net.snk, for the InternalsVisibleTo grant to the equally signed tests. -->
    <Mdf4NetPublicKey></Mdf4NetPublicKey>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mdf4Net.Tests" Key="$(Mdf4NetPublicKey)" />
  </ItemGroup>

</Project>
