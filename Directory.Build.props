<Project>

  <PropertyGroup Label="Repository layout">
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <RepoArtifactsDir>$(RepositoryRoot)artifacts/</RepoArtifactsDir>
    <PackageOutputPath>$(RepoArtifactsDir)nuget/</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup Label="Language">
    <!--
      C# 14 because the Polyfill package used by the test project ships sources with extension
      members, which do not parse below 14. The language version is independent of the target
      frameworks, so the netstandard2.0 asset is unaffected.
    -->
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!--
      A pinned level, not `latest`: with `latest` the set of enabled rules moves with the SDK, and
      together with TreatWarningsAsErrors an unrelated SDK bump turns the build red. Raising it is
      a deliberate edit in its own pull request.
    -->
    <AnalysisLevel>10.0</AnalysisLevel>
    <!--
      Warnings are errors in CI only, so a half-written method does not break every local build.
      Code style is enforced by the `format` job alone (EnforceCodeStyleInBuild would duplicate it).
    -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Versioning">
    <!--
      The build never computes a version, it only receives one:
        * release  -> semantic-release passes -p:Version=X.Y.Z from the conventional commits;
        * CI       -> the `version` job runs GitVersion once and passes its SemVer to every job;
        * anything else (plain `dotnet build`, an IDE) -> VersionPrefix below.
      GitVersion deliberately does not run as an MSBuild task: versioning is a pipeline concern.
      To see what GitVersion makes of a working copy:  dotnet tool restore && dotnet gitversion
    -->
    <VersionPrefix>0.0.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup Label="Package identity">
    <Authors>Dietmar Borgards</Authors>
    <Company>Dietmar Borgards</Company>
    <Product>Mdf4Net</Product>
    <Copyright>Copyright (c) 2026 Dietmar Borgards</Copyright>
    <PackageProjectUrl>https://github.com/dborgards/Mdf4Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dborgards/Mdf4Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <PropertyGroup Label="Reproducible builds">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == '' AND '$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
