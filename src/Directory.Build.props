<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="Shipping libraries">
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>MDF;MDF4;MF4;ASAM;measurement;data-logging;bus-logging;CAN;CAN-FD;automotive;industrial</PackageTags>
  </PropertyGroup>

  <PropertyGroup Label="Package validation">
    <!--
      Every pack checks the package for target-framework consistency and, once a baseline is set,
      compares its public surface with the last release on nuget.org: ApiCompat can tell additive
      from breaking per target framework, which the API approval tests cannot.

      The baseline is empty until the first release. semantic-release then moves it right after
      every NuGet push (eng/set-package-validation-baseline.py, chained behind the push in the exec
      plugin's publishCmd), so it only ever names a version nuget.org has.

      CP0003 compares assembly versions and is silenced only for a pack whose version is 0.0.0:
      a local `dotnet pack` given none, and the CI fallback `0.0.0-unversioned.<run>`.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.0</PackageValidationBaselineVersion>
    <NoWarn Condition="'$(Version)' == '' Or $(Version.StartsWith('0.0.0'))">$(NoWarn);CP0003</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="Per-package README shipped inside the .nupkg">
    <None Include="README.md" Pack="true" PackagePath="" Condition="Exists('README.md')" />
  </ItemGroup>

</Project>
